{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northwind.example/schemas/rate_table.schema.json",
  "title": "RateTable",
  "description": "Premium rates for one plan and plan year, keyed by state and age band.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rate_table_id",
    "plan_id",
    "plan_year",
    "currency",
    "rate_basis",
    "age_bands",
    "rates_by_state"
  ],
  "properties": {
    "rate_table_id": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{4}-[0-9]{4}[A-Z]$" },
    "plan_id": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{4}$" },
    "plan_year": { "type": "integer", "minimum": 2020, "maximum": 2035 },
    "currency": { "type": "string", "enum": ["USD"] },
    "rate_basis": {
      "type": "string",
      "enum": ["flat_monthly_per_member", "per_1000_of_benefit_monthly"]
    },
    "age_bands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$" }
    },
    "rates_by_state": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Z]{2}$": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[0-9]{2}-[0-9]{2}$": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
